# ncon systemd service file
#
# Installation (or use scripts/install-system.sh):
#   sudo install -Dm755 target/release/ncon /usr/local/bin/ncon
#   sudo install -Dm644 ncon@.service /etc/systemd/system/ncon@.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ncon@tty1
#
# Configuration:
#   System config: /etc/ncon/config.toml
#   Generate with: sudo ncon --init-config=system
#
# The unit holds its VT in VT_PROCESS mode (SIGUSR1=acquire, SIGUSR2=release),
# so it releases the DRM master while switched away and re-acquires on return.
#
# VT handling follows kmsconvt@.service: ncon waits until its VT is the active
# one instead of giving up, and if it cannot run at all the VT falls back to a
# plain getty login prompt rather than staying dark.
#
# `Alias=autovt@.service` is the on-demand hook systemd-logind uses for "start
# a console on this freshly activated VT", but it only takes effect once
# /etc/systemd/system/autovt@.service points at ncon@.service (distributions
# usually point that link at getty@.service). See scripts/install-system.sh.

[Unit]
Description=ncon terminal emulator on %I
Documentation=https://github.com/nefinita/ncon
After=systemd-user-sessions.service plymouth-quit-wait.service
After=rc-local.service
Before=getty@%i.service getty.target
Conflicts=getty@%i.service kmsconvt@%i.service
# Same safety net as kmsconvt@.service: if ncon cannot run (or keeps exiting
# cleanly until the start limit trips), give this VT a real login prompt.
OnFailure=getty@%i.service
ConditionPathExists=/dev/%I
# Belt against a hypothetical "exits immediately with status 0" loop.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
Environment=NCON_BACKEND=vt
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/ncon
WorkingDirectory=/root
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=%I

# Restart only after a *clean* exit, which for ncon means "the user logged
# out" — that is what brings the login prompt back (kmscon keeps a session
# manager alive for this, ncon does not). A crash never loops: the unit goes
# to failed and OnFailure= above starts getty on this VT instead, exactly like
# kmsconvt@.service.
Restart=on-success
RestartSec=1

LimitNOFILE=65535

# DRM/KMS + VT control. Deliberately *no* CapabilityBoundingSet here: the
# bounding set is inherited by every process in the terminal (login → shell →
# whatever the user runs), and the kernel refuses to exec a binary whose file
# capabilities are not a subset of it — btop, kwin_wayland, ksgrd_network_helper
# and friends fail with EPERM inside ncon. A terminal emulator has to stay a
# normal environment for its children, so we only add the ambient cap we need.
AmbientCapabilities=CAP_SYS_TTY_CONFIG

[Install]
Alias=autovt@.service
WantedBy=getty.target
DefaultInstance=tty1
